# Publish to npmjs only, with provenance. One registry, one auth variable.
#
# The previous file mapped the `@citratenetwork` scope to GitHub Packages and
# bound `//npm.pkg.github.com/:_authToken` to ${NODE_AUTH_TOKEN} — the SAME
# variable the publish workflow sets to the npmjs publish token. A single future
# `@citratenetwork/*` dependency (or a poisoned lockfile that adds one) would
# then have sent the npmjs publish credential to npm.pkg.github.com: the
# credential-scope half of a dependency-confusion setup, pre-armed. Removed.
# Audit: SMK-B-009.
registry=https://registry.npmjs.org/
provenance=true
