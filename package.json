{
  "name": "@citratelabs/marketplace-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Citrate compute marketplace. Contract bindings, ABI decoders, x402 payment client, and types matching the Rust gateway.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:publish": "tsc -p tsconfig.publish.json",
    "prepare": "tsc",
    "prepublishOnly": "rm -rf dist && tsc -p tsconfig.publish.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "sync-addresses": "node scripts/sync-addresses.mjs",
    "sync-addresses:check": "node scripts/sync-addresses.mjs --check"
  },
  "keywords": [
    "citrate",
    "compute",
    "marketplace",
    "x402",
    "ai",
    "ethereum"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^8.57.1",
    "happy-dom": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "ws": ">=8.21.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CitrateNetwork/citrate-sdk-marketplace.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
